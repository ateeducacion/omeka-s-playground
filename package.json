{
  "name": "omeka-s-playground",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare-runtime": "node ./scripts/prepare-runtime.mjs",
    "build:version": "node ./scripts/write-build-version.mjs",
    "sync-browser-deps": "node ./scripts/sync-browser-deps.mjs",
    "build-worker": "node ./scripts/esbuild.worker.mjs",
    "bundle": "./scripts/build-omeka-bundle.sh",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@php-wasm/fs-journal": "^3.1.58",
    "@php-wasm/stream-compression": "^3.1.58",
    "@php-wasm/universal": "^3.1.58",
    "@php-wasm/web": "^3.1.58",
    "fflate": "^0.8.3",
    "zstddec": "^0.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "^1.64.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "c8": "12.0.0",
    "esbuild": "^0.28.2",
    "happy-dom": "21.0.4"
  },
  "overrides": {
    "@php-wasm/universal": "$@php-wasm/universal",
    "@php-wasm/web": "$@php-wasm/web"
  }
}
